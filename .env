ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-key-32-chars-long-security-secret-key-12345
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/job_assistant_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/job_assistant_test_db

JWT_SECRET_KEY=super-secret-jwt-signing-key-dev-environment-123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
