# App Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-a-secure-random-64-char-string
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_assistant_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_assistant_test_db

# Security & JWT Tokens
JWT_SECRET_KEY=super-secret-jwt-signing-key-change-this-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting & Lockout
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# File Storage & CV Intake
MAX_UPLOAD_SIZE_MB=10
STORAGE_DIR=./storage/cvs
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash


# RAG uses its own OpenAI credentials. Never set RAG_TEST_MODE in production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TEST_MODE=false
RAG_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP_TOKENS=60
RAG_CONTEXT_TOKENS=4000
RAG_HISTORY_TOKENS=2000
RAG_OUTPUT_TOKENS=1000
RAG_MIN_SIMILARITY=0.25
RAG_DAILY_TOKEN_BUDGET=100000
# Production requires redis:// or rediss:// shared by API and worker.
RATE_LIMIT_STORAGE_URI=memory://
RAG_CHAT_RATE_LIMIT=20/minute
RAG_SYNC_RATE_LIMIT=2/minute
